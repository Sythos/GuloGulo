source "https://rubygems.org"

# Pins this site to the exact gem versions GitHub Pages itself builds with,
# so a local `bundle exec jekyll serve` matches production. Not required for
# the GitHub-hosted build (which ignores this Gemfile and uses its own
# github-pages gem internally) - this is only for local preview/dev.
gem "github-pages", group: :jekyll_plugins
