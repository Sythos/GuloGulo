{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "lib": ["ES2022", "DOM"],
    "allowJs": false
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "web/src/**/*.ts",
    "web/build.ts",
    "web/test/web-shell.test.ts"
  ],
  "exclude": [
    "dist",
    "web/dist",
    "node_modules"
  ]
}
