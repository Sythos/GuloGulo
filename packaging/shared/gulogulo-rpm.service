#
# systemd unit for the cPanel/WHM RPM target. Staged verbatim into the RPM
# source tarball by build-cpanel-package.ts and installed by gulogulo.spec's
# %install section at %{_unitdir}/gulogulo.service - unlike
# gulogulo-deb.service.template (used by the Plesk/.deb target), this file
# has no placeholders to substitute at install time: an RPM install location
# is fixed by packaging convention (/opt/gulogulo, the "gulogulo" system
# user, /var/lib/gulogulo), not chosen by the operator at extraction time, so
# every path below is already final. If Node.js is not installed at
# /usr/bin/node on a given host (e.g. a non-standard install method), edit
# ExecStart below and run `systemctl daemon-reload` before starting the
# service.
#
# Lives under packaging/shared/ (rather than packaging/cpanel/) because it
# is conceptually the same systemd unit gulogulo-deb.service.template
# describes, just pre-rendered for the RPM target's fixed install layout -
# keeping both next to each other avoids one packaging target reaching into
# another target's directory for a file it needs.

[Unit]
Description=Gulo Gulo groupware runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gulogulo
Group=gulogulo
WorkingDirectory=/opt/gulogulo
ExecStart=/usr/bin/node --env-file=/opt/gulogulo/.env /opt/gulogulo/dist/server/src/runtime/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The service needs write access only here - GULOGULO_MAILBOX_ROOT and patch
# status files, if configured, must live under this path.
ReadWritePaths=/var/lib/gulogulo
PrivateTmp=true

[Install]
WantedBy=multi-user.target
