#
# Example systemd unit for a standalone Gulo Gulo install. This file is not
# installed automatically. To use it:
#   1. Copy it to /etc/systemd/system/gulogulo.service
#   2. Edit WorkingDirectory/ExecStart below to match your install path
#   3. Create a dedicated, unprivileged system user (e.g. `useradd --system gulogulo`)
#   4. systemctl daemon-reload && systemctl enable --now gulogulo

[Unit]
Description=Gulo Gulo groupware runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gulogulo
Group=gulogulo
WorkingDirectory=/opt/gulogulo
ExecStart=/usr/bin/node --env-file=/opt/gulogulo/.env /opt/gulogulo/dist/server/src/runtime/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# Adjust to wherever GULOGULO_MAILBOX_ROOT and patch status files actually
# live for this install; the service needs write access there only.
ReadWritePaths=/var/lib/gulogulo
PrivateTmp=true

[Install]
WantedBy=multi-user.target
