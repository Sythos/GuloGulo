#
# Gulo Gulo reverse proxy - Apache/EasyApache 4 example, for the cPanel/WHM
# RPM target. cPanel's Apache configuration is generated by EasyApache 4
# from templates/userdata; editing /etc/apache2/conf/httpd.conf directly is
# unsafe because WHM regenerates it and would discard manual edits. This
# file ships as documentation only (RPM %doc, installed at
# /usr/share/doc/gulogulo/gulogulo-proxy.conf.example) and is NEVER applied
# automatically by gulogulo.spec's %pre/%post/%preun/%postun scriptlets -
# copy the block below into one of Apache's supported extension points
# yourself, review it, and reload Apache when ready:
#
#   1. WHM > Service Configuration > Apache Configuration > Include Editor.
#      Paste into "Pre Main Include" (applies to every vhost) or into a
#      specific virtual host's own include (applies only to that domain/
#      subdomain), then click "Update".
#   2. Or, per-account userdata hook (scriptable/repeatable installs):
#        /etc/apache2/conf.d/userdata/std/2_4/<cpanel-user>/<domain>/gulogulo.conf
#      then rebuild and restart Apache:
#        /scripts/rebuildhttpdconf && systemctl restart httpd
#
# Requires mod_proxy and mod_proxy_http to be enabled in the EasyApache 4
# profile (they are part of the default cPanel Apache MPM/module set on
# most current builds; check WHM > EasyApache 4 if ProxyPass is refused).
#
# Replace example.com with the real domain/subdomain that should serve
# Gulo Gulo, and adjust the upstream port below yourself if PORT in
# /opt/gulogulo/.env is not the default 8080 - unlike the retired tar.gz
# installer, this file is no longer rewritten automatically at install
# time, since it now ships as a packaged doc file rather than a copy in an
# operator-writable install directory.

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName example.com
    SSLEngine on
    # Reuse the domain's existing cPanel-issued certificate/key paths, or
    # point these at your own; do not duplicate certificate management here.
    # SSLCertificateFile   /path/to/fullchain.pem
    # SSLCertificateKeyFile /path/to/privkey.pem

    ProxyPreserveHost On
    ProxyPass "/" "http://127.0.0.1:8080/"
    ProxyPassReverse "/" "http://127.0.0.1:8080/"
</VirtualHost>
</IfModule>
