#
# Copy this file to .env for local Compose use. These values are intentionally
# non-secret placeholders. Do not commit a populated .env file or credentials.
# The default, unprofiled Compose service is the local runtime. Optional
# disposable runners are selected with --profile local, --profile test, or
# --profile fixture.

GULOGULO_HTTP_PORT=8080
GULOGULO_VOLUME_PREFIX=gulogulo-local
# Set true only after the named volumes have been created by the deployment
# operator. External volumes survive container recreation and image upgrades.
GULOGULO_VOLUMES_EXTERNAL=false
HOST=0.0.0.0
PORT=8080
APP_ENV=development
GULOGULO_HOST=0.0.0.0
GULOGULO_PORT=8080
GULOGULO_ENV=development
GULOGULO_VERSION=0.0.0
GULOGULO_BUILD_DIGEST=development
GULOGULO_PATCH_MODE=build_and_operator
GULOGULO_PATCH_STATUS_FILE=/var/lib/gulogulo/patch/status.json
GULOGULO_SERVICE_NAME=gulogulo-runtime
GULOGULO_SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
LOG_FORMAT=json
GULOGULO_FIXTURE_MODE=false
GULOGULO_FIXTURE_MANIFEST=/app/test/fixtures/manifest.json

# External LDAP is disabled in the empty scaffold. Replace the endpoint and
# provide the bind secret through a deployment secret mechanism before enabling
# it. LDAP_BIND_SECRET_REF is a reference only; it is never a credential value.
LDAP_ENABLED=false
LDAP_URL=ldaps://127.0.0.1:636
LDAP_STARTTLS=false
LDAP_BIND_DN=
LDAP_BIND_SECRET_REF=
LDAP_CONNECT_TIMEOUT_MS=3000
LDAP_OPERATION_TIMEOUT_MS=5000
LDAP_POOL_MAX=4
LDAP_RETRY_ATTEMPTS=2

# External PostgreSQL is disabled in the empty scaffold. Replace the endpoint
# and provide the complete DSN through a deployment secret mechanism before
# enabling it. POSTGRES_DSN_SECRET_REF is a reference only; it is never a
# password or connection-string value.
POSTGRES_ENABLED=false
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=gulogulo
POSTGRES_USER=gulogulo
POSTGRES_DSN_SECRET_REF=
POSTGRES_SSLMODE=verify-full
POSTGRES_CONNECT_TIMEOUT_MS=3000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_POOL_MAX=8
POSTGRES_RETRY_ATTEMPTS=2
