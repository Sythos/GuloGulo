#
# Copy this file to .env for local Compose use. These values are intentionally
# non-secret placeholders. Do not commit a populated .env file or credentials.
# The default, unprofiled Compose service is the local runtime. Optional
# disposable runners are selected with --profile local, --profile test, or
# --profile fixture.

GULOGULO_HTTP_PORT=8080
GULOGULO_VOLUME_PREFIX=gulogulo-local
# Set true only after the named volumes have been created by the deployment
# operator. External volumes survive container recreation and image upgrades.
GULOGULO_VOLUMES_EXTERNAL=false
GULOGULO_LP1_VOLUMES_EXTERNAL=false
GULOGULO_PROOF_NETWORK=gulogulo-local-proof
GULOGULO_PROOF_HTTP_PORT=18080
GULOGULO_PROOF_APP_HOST=::
LP1_DNS_PORT=5353
# LP2 is an opt-in, local-only dependency proof. Its credentials and data are
# synthetic placeholders and must never be reused for a deployed environment.
GULOGULO_LP2_VOLUMES_EXTERNAL=false
GULOGULO_LP2_NETWORK=gulogulo-lp2-runtime
LP2_LDAP_ROOT_DN=cn=admin,dc=gulogulo,dc=test
LP2_LDAP_ROOT_PASSWORD=lp2-synthetic-root
LP2_LDAP_BASE_DN=dc=gulogulo,dc=test
LP2_LDAP_USER_BASE_DN=ou=users,dc=gulogulo,dc=test
LP2_POSTGRES_DB=gulogulo
LP2_POSTGRES_USER=gulogulo
LP2_POSTGRES_PASSWORD=lp2-synthetic-postgres
# LP5 is a private, synthetic operations/capacity proof. The smoke harness
# generates these credentials at runtime; they are placeholders for Compose
# config validation only and must never be reused in a deployment.
GULOGULO_LP5_VOLUMES_EXTERNAL=false
GULOGULO_LP5_NETWORK=gulogulo-lp5-runtime
# LP5_LOGIN_EMAIL and LP5_LOGIN_PASSWORD are required runtime inputs generated
# by scripts/lp5-compose-smoke.ts; deliberately do not put values here.
LP5_TENANT_ID=acme
LP5_TENANT_DOMAIN=example.test
LP5_USER_ID=alice

# Rspamd and ClamAV definitions are data, not image state. A provider-owned
# updater publishes verified generations into this external volume and swaps
# the active pointer atomically; scanner containers mount it read-only. The
# local LP3 smoke harness uses a disposable named volume and a deterministic
# fixture instead.
GULOGULO_SCANNER_SIGNATURE_ROOT=/var/lib/gulogulo/scanner-signatures
GULOGULO_SCANNER_SIGNATURE_MAX_AGE_SECONDS=604800
GULOGULO_LP3_SCANNER_SIGNATURES_VOLUME=gulogulo-scanner-signatures
HOST=0.0.0.0
PORT=8080
APP_ENV=development
GULOGULO_HOST=0.0.0.0
GULOGULO_PORT=8080
GULOGULO_ENV=development
GULOGULO_VERSION=0.1.4
GULOGULO_BUILD_DIGEST=development
GULOGULO_PATCH_MODE=build_and_operator
GULOGULO_PATCH_STATUS_FILE=/var/lib/gulogulo/patch/status.json
GULOGULO_SERVICE_NAME=gulogulo-runtime
GULOGULO_SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
LOG_FORMAT=json
GULOGULO_FIXTURE_MODE=false
GULOGULO_FIXTURE_MANIFEST=/app/test/fixtures/manifest.json

# Selects which ADR-002 packaging target's PlatformAdapter the production
# login/session wiring (src/runtime/login.ts) resolves at startup: standalone
# (default), cpanel, or plesk. Only relevant when GULOGULO_FIXTURE_MODE=false.
GULOGULO_PLATFORM=standalone

# Selects which identity source the standalone target's PlatformAdapter uses:
# "ldap" (default, see below) or "database" (a PostgreSQL-backed local_users
# table via src/platform/standalone/db-identity-client.ts — requires
# POSTGRES_ENABLED=true). Ignored by the cpanel/plesk targets, which always
# use their own panel API.
IDENTITY_SOURCE=ldap

# External LDAP is disabled in the empty scaffold. Replace the endpoint and
# provide the bind secret through a deployment secret mechanism before enabling
# it. LDAP_BIND_SECRET_REF is a reference only; it is never a credential value.
# In production (src/runtime/login.ts), a *SecretRef value such as
# "ldap/bind" resolves from an environment variable named
# GULOGULO_SECRET_<REF UPPERCASED, NON-ALNUM REPLACED WITH _> — e.g.
# GULOGULO_SECRET_LDAP_BIND. Set those directly in the deployment environment;
# never put the secret value itself here. "postgres/dsn" is the one
# exception: it resolves from GULOGULO_POSTGRES_DSN, the same variable
# packaging/standalone/scripts/run-migrations.mjs already documents and reads
# (see doc/identity-and-postgres.md).
LDAP_ENABLED=false
LDAP_URL=ldaps://127.0.0.1:636
LDAP_STARTTLS=false
LDAP_BIND_DN=
LDAP_BIND_SECRET_REF=
LDAP_CONNECT_TIMEOUT_MS=3000
LDAP_OPERATION_TIMEOUT_MS=5000
LDAP_POOL_MAX=4
LDAP_RETRY_ATTEMPTS=2

# External PostgreSQL is disabled in the empty scaffold. Replace the endpoint
# and provide the complete DSN through a deployment secret mechanism before
# enabling it. POSTGRES_DSN_SECRET_REF is a reference only; it is never a
# password or connection-string value.
POSTGRES_ENABLED=false
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=gulogulo
POSTGRES_USER=gulogulo
POSTGRES_DSN_SECRET_REF=
POSTGRES_SSLMODE=verify-full
POSTGRES_CONNECT_TIMEOUT_MS=3000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_POOL_MAX=8
POSTGRES_RETRY_ATTEMPTS=2

# Optional upstream tenant tool. The panel may own hosting-account and DNS
# workflows, but Gulo Gulo remains authoritative for groupware policy,
# identity, application state, mailbox content, and audit. Secret variables are
# references only; never put a token or password here.
CONTROL_PANEL_ENABLED=false
CONTROL_PANEL_PROVIDER=none
CONTROL_PANEL_BASE_URL=
CONTROL_PANEL_ACCOUNT_REF=
CONTROL_PANEL_CREDENTIAL_SECRET_REF=
CONTROL_PANEL_WEBHOOK_SECRET_REF=
CONTROL_PANEL_SYNC_MODE=pull

# cPanel UAPI identity integration (src/platform/cpanel/), used only by the
# `cpanel` platform target's identity adapter (CpanelApiSettings in
# src/integrations/types.ts) - unrelated to CONTROL_PANEL_* above. Disabled
# by default. These values are read by src/runtime/config.ts's loader like
# every other section (see src/platform/cpanel/README.md).
# CPANEL_API_TOKEN_SECRET_REF is a reference only, never a token value.
CPANEL_API_ENABLED=false
CPANEL_API_BASE_URL=https://127.0.0.1:2083
CPANEL_API_USERNAME=
CPANEL_API_TOKEN_SECRET_REF=
CPANEL_API_TIMEOUT_MS=5000

# Plesk REST API identity integration (src/platform/plesk/), used only by the
# `plesk` platform target's identity adapter (PleskApiSettings in
# src/integrations/types.ts) - unrelated to CONTROL_PANEL_* above. Disabled
# by default. These values are read by src/runtime/config.ts's loader like
# every other section (see src/platform/plesk/README.md).
# PLESK_API_KEY_SECRET_REF is a reference only, never an API key value.
PLESK_API_ENABLED=false
PLESK_API_BASE_URL=https://127.0.0.1:8443
PLESK_API_KEY_SECRET_REF=
PLESK_API_TIMEOUT_MS=5000

# M3 mail-core contract defaults. Vendor services (Postfix, Rspamd, ClamAV,
# and Dovecot) remain separately deployed; these values define the safe
# application boundary and never contain credentials or message content.
GULOGULO_MAIL_IMAP_IDLE=true
GULOGULO_MAIL_POP3S_ENABLED=false
GULOGULO_MAIL_CATCH_ALL=false
GULOGULO_MAIL_USER_FORWARDING=false
GULOGULO_MAIL_SMTP_INBOUND_PORT=25
GULOGULO_MAIL_SMTP_SUBMISSION_PORT=587
GULOGULO_MAIL_SMTP_IMPLICIT_TLS_PORT=465
GULOGULO_MAIL_IMAPS_PORT=993
GULOGULO_MAIL_LMTP_SOCKET=/var/run/dovecot/lmtp
GULOGULO_MAILBOX_ROOT=/var/lib/gulogulo/mail
GULOGULO_MAIL_RSPAMD_ENABLED=true
GULOGULO_MAIL_CLAMAV_ENABLED=true
GULOGULO_MAIL_SCAN_FAILURE_MODE=fail_closed
GULOGULO_MAIL_MAX_MESSAGE_BYTES=52428800
GULOGULO_MAIL_MAX_RECIPIENTS=100
GULOGULO_MAIL_MAX_CONNECTIONS_PER_IP=20
GULOGULO_MAIL_MAX_MESSAGES_PER_USER_PER_MINUTE=60
GULOGULO_MAIL_QUEUE_MAX_ATTEMPTS=5
GULOGULO_MAIL_QUEUE_RETRY_BASE_MS=60000

# LP6 is a private, synthetic backup/restore/retention/DR proof. The smoke
# harness generates LP6_TEST_KEY_B64 at runtime; never commit a real key.
GULOGULO_LP6_VOLUMES_EXTERNAL=false
GULOGULO_LP6_NETWORK=gulogulo-lp6-runtime
GULOGULO_LP6_COMPOSE_PLATFORM=linux/amd64
LP6_TEST_KEY_B64=
LP6_KEY_REFERENCE=kms/local-synthetic/lp6-v1
