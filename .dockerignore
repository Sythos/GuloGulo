# Version-control and CI metadata are not required in the runtime image.
.git
.git/**
.github
.github/**

# Never send local credentials or environment files to the Docker daemon.
.env
.env.*
!.env.example

# Local dependency trees and generated output are rebuilt in the image.
node_modules
coverage
dist
build
tmp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and operating-system metadata.
.idea
.vscode
.DS_Store
Thumbs.db
