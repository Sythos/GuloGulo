# Synthetic LP3 configuration. It accepts only the internal fixture domain and
# hands accepted messages to Dovecot LMTP; it is intentionally not an Internet
# relay and has no external delivery path.
compatibility_level = 3.6
myhostname = lp3-postfix.gulogulo.test
mydomain = gulogulo.test
myorigin = $mydomain
inet_interfaces = all
inet_protocols = all
mydestination = localhost, localhost.$mydomain
mynetworks = 127.0.0.0/8, [::1]/128, 172.29.3.0/24, [fd42:4755:756c:7033::]/64
relay_domains =

virtual_mailbox_domains = static:gulogulo.test
virtual_mailbox_maps = regexp:/etc/postfix/lp3-mailboxes.regexp
virtual_alias_maps = regexp:/etc/postfix/lp3-aliases.regexp
virtual_transport = lmtp:inet:lp3-dovecot:24

smtpd_relay_restrictions = reject_unauth_destination
smtpd_recipient_restrictions = reject_unauth_destination
smtpd_client_restrictions = permit
smtpd_helo_required = yes
disable_vrfy_command = yes
message_size_limit = 52428800

smtpd_tls_cert_file = /run/gulogulo-lp3-tls/lp3-postfix.crt
smtpd_tls_key_file = /run/gulogulo-lp3-tls/lp3-postfix.key
smtpd_tls_CAfile = /run/gulogulo-lp3-tls/ca.crt
smtpd_tls_security_level = may
smtpd_tls_auth_only = no
smtpd_tls_loglevel = 0

# Scanner services are proved independently by the LP3 proof client. Leaving
# Milter hooks empty prevents this deterministic fixture from pretending to be
# a production Rspamd/ClamAV integration.
smtpd_milters =
non_smtpd_milters =
unknown_local_recipient_reject_code = 550
